# ==========================================
# Resume Analyzer - Root Git Ignore
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
dist-ssr/
build/
out/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files and backups
*.bak
*.bak2
*.tmp
*.temp
*.swp
*.swo
*~

# Python environments and cache
.venv/
venv/
env/
__pycache__/
*.py[cod]

# Nested duplicate project folder
/interview-ai-yt-main/

# Editor and IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.user
*.userosscache

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Test and debug artifacts
.nyc_output/
playwright-report/
test-results/

# Local database and uploaded files
*.sqlite
*.sqlite3
*.db
uploads/
temp/

# Package manager and tool caches
.npm/
.eslintcache
.parcel-cache/
.turbo/

# Vite
vite.config.*.timestamp-*
